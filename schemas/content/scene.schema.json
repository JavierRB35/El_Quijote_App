{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JavierRB35/El_Quijote_App/schemas/content/scene.schema.json",
  "title": "Scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "contract_version", "episode_id", "phase", "media_ids", "accessibility"],
  "properties": {
    "id": { "$ref": "_definitions.schema.json#/$defs/sceneId" },
    "contract_version": { "$ref": "_definitions.schema.json#/$defs/ContractVersion" },
    "episode_id": { "$ref": "_definitions.schema.json#/$defs/episodeId" },
    "phase": { "$ref": "_definitions.schema.json#/$defs/ScenePhase" },
    "media_ids": { "type": "array", "items": { "$ref": "_definitions.schema.json#/$defs/mediaAssetId" }, "uniqueItems": true,
      "$comment": "Obligatorio (el campo no desaparece), pero en v1.2.0 admite []: escena sin recursos visuales propios (fondo neutro del modo Historia). En registros 1.0.0/1.1.0 la restricción minItems 1 se aplica vía allOf (compatibilidad preservada). El consumidor no trata [] como error de carga: es una escena deliberadamente neutra." },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["media_id", "depth"],
        "properties": {
          "media_id": { "$ref": "_definitions.schema.json#/$defs/mediaAssetId" },
          "depth": { "type": "string", "enum": ["fondo", "medio", "primer_plano", "efecto"] },
          "parallax": { "type": "number", "minimum": 0, "maximum": 1, "$comment": "0 = fijo, 1 = máximo desplazamiento. Con movimiento reducido, parallax debe ignorarse (encargo §5.2.3)." }
        }
      }
    },
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "media_id", "area", "label", "keyboard_accessible"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "media_id": { "$ref": "_definitions.schema.json#/$defs/mediaAssetId" },
          "area": { "$ref": "_definitions.schema.json#/$defs/NormalizedArea" },
          "label": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean", "default": true, "$comment": "Los puntos interactivos son SIEMPRE opcionales (encargo §2.1); 'optional': false está prohibido por diseño." },
          "keyboard_accessible": { "type": "boolean", "enum": [true] }
        }
      }
    },
    "subtitles_ref": { "type": "string", "$comment": "URI lógica de la pista de subtítulos sincronizados (encargo §5.4)." },
    "audio_ref": { "type": "string" },
    "entry_transition": { "type": "string", "enum": ["fade", "dissolve", "pan", "corte"] },
    "exit_transition": { "type": "string", "enum": ["fade", "dissolve", "pan", "corte"] },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reduced_motion_fallback", "alt"],
      "properties": {
        "reduced_motion_fallback": { "type": "string", "enum": ["imagen_estatica"], "$comment": "Fallback obligatorio sin animación (encargo §4.7.7, §5.2.3)." },
        "alt": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "contract_version": { "enum": ["1.0.0", "1.1.0"] } }, "required": ["contract_version"] },
      "then": {
        "properties": { "media_ids": { "minItems": 1 } },
        "$comment": "Compatibilidad: los arrays vacíos de media_ids solo están autorizados a partir de v1.2.0 (v1.2.0 §media_ids)."
      }
    }
  ]
}
