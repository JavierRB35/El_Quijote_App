{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question.schema.json",
  "title": "Question",
  "$comment": "BORRADOR 0.1 (modo CONTENIDOS, 2026-11-05) — propiedad conjunta, pendiente de revisión técnica. Tipos: single_choice, multi_choice, true_false, ordering, matching, hotspot. Todas de respuesta seleccionada (DC-04).",
  "type": "object",
  "required": ["id", "schema_version", "episode_id", "chapter_ids", "passage_ids",
               "prompt", "type", "options", "rationale", "evidence", "difficulty",
               "spoiler_policy", "review_state", "semantic_key"],
  "properties": {
    "id": {"type": "string", "pattern": "^DQ\\.Q\\.[0-9]{6}$"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "episode_id": {"type": "string", "pattern": "^DQ\\.P[12]\\.E[0-9]{2}$"},
    "chapter_ids": {"type": "array", "minItems": 1,
                    "items": {"type": "string", "pattern": "^DQ\\.P[12]\\.C[0-9]{2}$"}},
    "passage_ids": {"type": "array", "minItems": 1,
                    "items": {"type": "string", "pattern": "^DQ\\.P[12]\\.C[0-9]{2}\\.PS[0-9]{3}$"}},
    "prompt": {"type": "string", "minLength": 15, "maxLength": 400},
    "type": {"enum": ["single_choice", "multi_choice", "true_false",
                       "ordering", "matching", "hotspot"]},
    "options": {"type": "array",
                "items": {"type": "object",
                          "required": ["id", "label"],
                          "properties": {
                            "id": {"type": "string", "pattern": "^DQ\\.Q\\.[0-9]{6}\\.O[a-z]$"},
                            "label": {"type": "string", "minLength": 1, "maxLength": 200}
                          },
                          "additionalProperties": false}},
    "correct_option_ids": {"type": "array", "minItems": 1,
                           "items": {"type": "string"}},
    "multi_select_hint": {"type": "boolean"},
    "solution": {"type": "object"},
    "rationale": {"type": "string", "minLength": 20},
    "evidence": {"type": "array", "minItems": 1,
                 "items": {"type": "object",
                           "required": ["kind", "ref", "certainty"],
                           "properties": {
                             "kind": {"enum": ["cita_literal", "parafraasis_localizada",
                                                "fuente_historica", "estudio_academico",
                                                "comentario_editorial"]},
                             "ref": {"type": "string", "minLength": 3},
                             "certainty": {"$ref": "#/$defs/certainty"}
                           },
                           "additionalProperties": false}},
    "difficulty": {"enum": ["facil", "media", "dificil"]},
    "spoiler_policy": {"enum": ["capitulo_actual", "episodios_anteriores", "siempre", "nunca"]},
    "scene_id": {"type": "string", "pattern": "^DQ\\.P[12]\\.E[0-9]{2}\\.S[0-9]{2}$"},
    "media_ids": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "review_state": {"enum": ["borrador", "documentada", "revisada", "aprobada", "descartada"]},
    "semantic_key": {"type": "string", "minLength": 8}
  },
  "$defs": {
    "certainty": {"enum": ["TEXTO_EXPLICITO", "HECHO_HISTORICO_DOCUMENTADO",
                            "INTERPRETACION_ACADEMICA", "HIPOTESIS_PLAUSIBLE",
                            "DISCUTIDO", "RECREACION_ARTISTICA"]}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "single_choice"}}, "required": ["type"]},
     "then": {"required": ["correct_option_ids"],
               "properties": {"options": {"minItems": 3},
                               "correct_option_ids": {"maxItems": 1}}}},
    {"if": {"properties": {"type": {"const": "multi_choice"}}, "required": ["type"]},
     "then": {"required": ["correct_option_ids", "multi_select_hint"],
               "properties": {"options": {"minItems": 3}}}},
    {"if": {"properties": {"type": {"const": "true_false"}}, "required": ["type"]},
     "then": {"required": ["correct_option_ids"],
               "properties": {"options": {"minItems": 2, "maxItems": 2}}}},
    {"if": {"properties": {"type": {"const": "ordering"}}, "required": ["type"]},
     "then": {"required": ["solution"],
               "properties": {"options": {"minItems": 2},
                               "solution": {"required": ["order"],
                                             "properties": {"order": {"type": "array",
                                                                       "minItems": 2,
                                                                       "items": {"type": "string"}}}}}}},
    {"if": {"properties": {"type": {"const": "matching"}}, "required": ["type"]},
     "then": {"required": ["solution"],
               "properties": {"options": {"minItems": 2},
                               "solution": {"required": ["pairs"],
                                             "properties": {"pairs": {"type": "array",
                                                                       "minItems": 2,
                                                                       "items": {"type": "object",
                                                                                  "required": ["left", "right"],
                                                                                  "properties": {"left": {"type": "string"},
                                                                                                  "right": {"type": "string"}}}}}}}}},
    {"if": {"properties": {"type": {"const": "hotspot"}}, "required": ["type"]},
     "then": {"required": ["solution", "media_ids"],
               "properties": {"media_ids": {"minItems": 1},
                               "solution": {"required": ["zones"],
                                             "properties": {"zones": {"type": "array",
                                                                       "minItems": 1,
                                                                       "items": {"type": "object",
                                                                                  "required": ["id", "rect"],
                                                                                  "properties": {"id": {"type": "string"},
                                                                                                  "rect": {"type": "array",
                                                                                                            "minItems": 4,
                                                                                                            "maxItems": 4,
                                                                                                            "items": {"type": "number",
                                                                                                                       "minimum": 0,
                                                                                                                       "maximum": 1}}}}}}}}}}
  ],
  "unevaluatedProperties": false
}
