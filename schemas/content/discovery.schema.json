{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JavierRB35/El_Quijote_App/schemas/content/discovery.schema.json",
  "title": "Discovery (cápsula de descubrimiento)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "contract_version", "kind", "content", "appearance", "certainty", "review"],
  "properties": {
    "id": { "$ref": "_definitions.schema.json#/$defs/discoveryId" },
    "contract_version": { "$ref": "_definitions.schema.json#/$defs/ContractVersion" },
    "kind": {
      "type": "string",
      "enum": ["cita_literal", "refran", "humor_escena", "curiosidad_recepcion", "lectura_posible", "alusion_historica"],
      "$comment": "Encargo §4.4. cita_literal y refran exigen pasaje y locutor: no se inventan citas."
    },
    "content": { "type": "string", "minLength": 1 },
    "speaker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "person_id": { "$ref": "_definitions.schema.json#/$defs/personId" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "context": { "type": "string" },
    "passages": { "type": "array", "items": { "$ref": "_definitions.schema.json#/$defs/passageId" }, "uniqueItems": true },
    "bibliography": { "type": "array", "items": { "$ref": "_definitions.schema.json#/$defs/sourceId" }, "uniqueItems": true },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id"],
      "properties": {
        "episode_id": { "$ref": "_definitions.schema.json#/$defs/episodeId" },
        "moment": { "type": "string", "enum": ["antes_pregunta", "tras_respuesta", "desenlace", "exploracion"] },
        "frequency_hint": { "type": "string", "enum": ["habitual", "ocasional", "raro"], "$comment": "Aparición habitual pero sin saturación (encargo §2.3, §4.4)." }
      }
    },
    "asset_ids": { "type": "array", "items": { "$ref": "_definitions.schema.json#/$defs/mediaAssetId" }, "uniqueItems": true },
    "certainty": { "$ref": "_definitions.schema.json#/$defs/Certainty" },
    "review": { "$ref": "_definitions.schema.json#/$defs/Review" },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "enum": ["cita_literal", "refran"] } }, "required": ["kind"] },
      "then": { "required": ["speaker", "passages"], "properties": { "passages": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "kind": { "enum": ["lectura_posible", "alusion_historica"] } }, "required": ["kind"] },
      "then": { "required": ["bibliography"], "properties": { "certainty": { "enum": ["INTERPRETACION_ACADEMICA", "HIPOTESIS_PLAUSIBLE", "DISCUTIDO"] }, "bibliography": { "minItems": 1 } } }
    }
  ]
}
