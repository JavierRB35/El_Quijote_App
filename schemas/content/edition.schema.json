{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edition.schema.json",
  "title": "Edition",
  "$comment": "BORRADOR 0.1 — edición de referencia. PEND-01: la edición española jurídicamente utilizable está por seleccionar.",
  "type": "object",
  "required": ["id", "title", "author", "orthography", "license_id", "consulted_date"],
  "properties": {
    "id": {"type": "string", "pattern": "^DQ\\.ED\\.[0-9]{4}$"},
    "title": {"type": "string"},
    "author": {"type": "string"},
    "editor_year": {"type": "string"},
    "source_url": {"type": "string"},
    "digital_version": {"type": "string"},
    "orthography": {"enum": ["original_1605", "moderna", "tasso_1905", "otra"],
                     "$comment": "tasso_1905 = ortografía modernizada de la ed. Tusell usada por el EPUB («á», «sabía» con diacrítico del s. XVII-XVIII conservado parcialmente)"},
    "license_id": {"type": "string", "pattern": "^DQ\\.LIC\\.[0-9]{4}$"},
    "checksum": {"type": "string"},
    "consulted_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "notes": {"type": "string"}
  },
  "unevaluatedProperties": false
}
