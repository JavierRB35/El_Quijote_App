{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "place_route.schema.json",
  "title": "PlaceRoute",
  "$comment": "BORRADOR 0.1 — lugar literario o ruta hipotética. geometry en GeoJSON (CRS WGS84); las rutas JAMÁS se presentan como hecho probado (DC-08).",
  "type": "object",
  "required": ["id", "literary_name", "status", "precision", "certainty", "review_state"],
  "properties": {
    "id": {"type": "string", "pattern": "^DQ\\.(LOC|RTE)\\.[0-9]{6}$"},
    "literary_name": {"type": "string"},
    "modern_name": {"type": "string"},
    "variants": {"type": "array", "items": {"type": "string"}},
    "geometry": {"type": "object",
                  "properties": {"type": {"enum": ["Point", "LineString"]},
                                  "coordinates": {"type": "array"},
                                  "crs": {"const": "WGS84"}}},
    "precision": {"enum": ["exacta", "aproximada", "discutida"]},
    "status": {"enum": ["explicito", "probable", "debatido", "patrimonio_asociado"]},
    "description": {"type": "string"},
    "chapter_ids": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^DQ\\.SRC\\.[0-9]{4}$"}},
    "heritage_links": {"type": "array", "items": {"type": "string"}},
    "attribution": {"type": "string"},
    "certainty": {"enum": ["TEXTO_EXPLICITO", "HECHO_HISTORICO_DOCUMENTADO",
                            "INTERPRETACION_ACADEMICA", "HIPOTESIS_PLAUSIBLE",
                            "DISCUTIDO", "RECREACION_ARTISTICA"]},
    "review_state": {"enum": ["borrador", "documentada", "revisada", "aprobada", "descartada"]}
  },
  "unevaluatedProperties": false
}
