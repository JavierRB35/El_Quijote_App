{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JavierRB35/El_Quijote_App/schemas/media/license.schema.json",
  "title": "License",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "contract_version", "title", "holder", "consulted_date", "attribution_required", "redistribution"],
  "properties": {
    "id": { "$ref": "../content/_definitions.schema.json#/$defs/licenseId" },
    "contract_version": { "$ref": "../content/_definitions.schema.json#/$defs/ContractVersion" },
    "title": { "type": "string", "minLength": 1 },
    "holder": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "consulted_date": { "$ref": "../content/_definitions.schema.json#/$defs/IsoDate" },
    "attribution_required": { "type": "boolean" },
    "redistribution": { "type": "string", "enum": ["permitida", "prohibida", "condicionada", "desconocida"], "$comment": "'desconocida' NO equivale a autorizada (encargo §6.3.4)." },
    "evidence_documental": { "type": "string", "$comment": "Dónde consta el permiso: URL del texto legal, correo, condiciones de uso de la institución (encargo §6.2)." },
    "notes": { "type": "string" }
  }
}
