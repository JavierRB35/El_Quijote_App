{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "license.schema.json",
  "title": "License",
  "$comment": "BORRADOR 0.1 — licencia formalizada. verified=false nunca permite uso en instalador ni web pública.",
  "type": "object",
  "required": ["id", "name", "allows", "verified", "certainty"],
  "properties": {
    "id": {"type": "string", "pattern": "^DQ\\.LIC\\.[0-9]{4}$"},
    "name": {"type": "string",
              "examples": ["Dominio público (publicado antes de 1930, EE. UU.)",
                            "CC BY 4.0", "CC BY-NC-SA", "Licencia comunitaria Epublibre",
                            "Derechos propios (recreación)"]},
    "text_ref": {"type": "string"},
    "allows": {"type": "array", "minItems": 1,
                "items": {"enum": ["uso_interno", "instalador", "web_publica", "redistribucion"]}},
    "attribution_required": {"type": "boolean"},
    "verified": {"type": "boolean"},
    "evidence": {"type": "string"},
    "certainty": {"enum": ["TEXTO_EXPLICITO", "HECHO_HISTORICO_DOCUMENTADO",
                            "INTERPRETACION_ACADEMICA", "HIPOTESIS_PLAUSIBLE",
                            "DISCUTIDO", "RECREACION_ARTISTICA"]},
    "notes": {"type": "string"}
  },
  "unevaluatedProperties": false
}
