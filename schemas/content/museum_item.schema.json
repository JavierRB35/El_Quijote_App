{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "museum_item.schema.json",
  "title": "MuseumItem",
  "$comment": "BORRADOR 0.1 — pieza de museo con ficha completa; no atribuir inequívocamente retratos no identificados (encargo §4.6).",
  "type": "object",
  "required": ["id", "title", "authorship_attribution", "source_id", "license_id",
               "explanation", "certainty", "review_state"],
  "properties": {
    "id": {"type": "string", "pattern": "^DQ\\.MUS\\.[0-9]{6}$"},
    "title": {"type": "string"},
    "authorship_attribution": {"type": "string",
                                "$comment": "con grado de atribución; «anónimo» es válido"},
    "date": {"type": "string"},
    "technique": {"type": "string"},
    "owner_entity": {"type": "string"},
    "source_id": {"type": "string", "pattern": "^DQ\\.SRC\\.[0-9]{4}$"},
    "license_id": {"type": "string", "pattern": "^DQ\\.LIC\\.[0-9]{4}$"},
    "media_ids": {"type": "array", "items": {"type": "string"}},
    "chapter_ids": {"type": "array", "items": {"type": "string"}},
    "explanation": {"type": "string", "minLength": 20},
    "relevance": {"type": "string"},
    "certainty": {"enum": ["TEXTO_EXPLICITO", "HECHO_HISTORICO_DOCUMENTADO",
                            "INTERPRETACION_ACADEMICA", "HIPOTESIS_PLAUSIBLE",
                            "DISCUTIDO", "RECREACION_ARTISTICA"]},
    "review_state": {"enum": ["borrador", "documentada", "revisada", "aprobada", "descartada"]}
  },
  "unevaluatedProperties": false
}
