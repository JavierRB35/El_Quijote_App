{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "person.schema.json",
  "title": "Person",
  "$comment": "BORRADOR 0.1 — personajes ficticios, históricos reales y atribuciones debatidas, siempre con clase y certeza (encargo §2.4).",
  "type": "object",
  "required": ["id", "name", "person_class", "certainty", "review_state"],
  "properties": {
    "id": {"type": "string", "pattern": "^DQ\\.PER\\.[0-9]{6}$"},
    "name": {"type": "string", "minLength": 2},
    "person_class": {"enum": ["ficticio", "historico", "debatido"]},
    "variants": {"type": "array", "items": {"type": "string"}},
    "description": {"type": "string"},
    "relations": {"type": "array", "items": {"type": "object",
                   "required": ["target_id", "kind"],
                   "properties": {"target_id": {"type": "string"},
                                    "kind": {"enum": ["amo_escudero", "familiar", "rival", "amor", "alusion_historica", "autor_ficticio"]}}}},
    "historical_ref": {"type": "string"},
    "appearance_chapter_ids": {"type": "array",
                                "items": {"type": "string", "pattern": "^DQ\\.P[12]\\.C[0-9]{2}$"}},
    "certainty": {"enum": ["TEXTO_EXPLICITO", "HECHO_HISTORICO_DOCUMENTADO",
                            "INTERPRETACION_ACADEMICA", "HIPOTESIS_PLAUSIBLE",
                            "DISCUTIDO", "RECREACION_ARTISTICA"]},
    "review_state": {"enum": ["borrador", "documentada", "revisada", "aprobada", "descartada"]}
  },
  "unevaluatedProperties": false
}
