{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "Source",
  "$comment": "BORRADOR 0.1 — fuente documental con fecha de consulta y límites de uso. «Desconocido» no equivale a «autorizado» (§6.3.4).",
  "type": "object",
  "required": ["id", "title", "consulted_date", "redistribution", "certainty"],
  "properties": {
    "id": {"type": "string", "pattern": "^DQ\\.SRC\\.[0-9]{4}$"},
    "title": {"type": "string"},
    "author_editor": {"type": "string"},
    "publication": {"type": "string"},
    "url": {"type": "string"},
    "consulted_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "use_limits": {"type": "string"},
    "attribution_required": {"type": "boolean"},
    "evidence": {"type": "string"},
    "redistribution": {"enum": ["prohibida", "con_permiso", "libre", "pendiente"]},
    "certainty": {"enum": ["TEXTO_EXPLICITO", "HECHO_HISTORICO_DOCUMENTADO",
                            "INTERPRETACION_ACADEMICA", "HIPOTESIS_PLAUSIBLE",
                            "DISCUTIDO", "RECREACION_ARTISTICA"]},
    "notes": {"type": "string"}
  },
  "unevaluatedProperties": false
}
