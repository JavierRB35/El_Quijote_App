{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JavierRB35/El_Quijote_App/blob/main/schemas/content/adventure-round.schema.json",
  "title": "Catálogo Aventura DC-34",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capituloId",
    "episodioId",
    "estado_editorial",
    "revision_visual",
    "fuente",
    "pendientes_editoriales",
    "rondas"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "capituloId": {
      "type": "string",
      "pattern": "^DQ\\.P[12]\\.C[0-9]{2}$"
    },
    "episodioId": {
      "type": "string",
      "pattern": "^DQ\\.P[12]\\.C[0-9]{2}\\.E[0-9]{2}$"
    },
    "estado_editorial": {
      "enum": [
        "borrador",
        "en_revision",
        "piloto_integrado",
        "aprobado"
      ]
    },
    "revision_visual": {
      "enum": [
        "pendiente",
        "verificada"
      ]
    },
    "fuente": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ruta"
      ],
      "properties": {
        "id": {
          "const": "DQ.SRC.0005"
        },
        "ruta": {
          "const": "content/textos/gutenberg_2000/El_Quijote.txt"
        }
      }
    },
    "pendientes_editoriales": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rondas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ronda"
      }
    }
  },
  "$defs": {
    "imagen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "alt"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^assets://scenes/.+\\.(webp|png|jpg|jpeg)$"
        },
        "alt": {
          "type": "string",
          "minLength": 16
        },
        "medioId": {
          "type": "string",
          "pattern": "^DQ\\.MA\\.[0-9]+$"
        }
      }
    },
    "opcion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "texto"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "texto": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "titulo"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "titulo": {
          "type": "string",
          "minLength": 3
        },
        "mayor": {
          "type": "boolean"
        }
      }
    },
    "ronda": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tramo",
        "contexto",
        "personaje",
        "pregunta",
        "opciones",
        "correcta",
        "consecuencia",
        "explicacion",
        "pasajeId",
        "imagenPrevia",
        "imagenConsecuencia"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AV2-(I|II)[0-9]+-[0-9]{2,3}$"
        },
        "tramo": {
          "type": "string",
          "minLength": 3
        },
        "contexto": {
          "type": "string",
          "minLength": 26
        },
        "personaje": {
          "type": "string",
          "minLength": 3
        },
        "pregunta": {
          "type": "string",
          "minLength": 5
        },
        "opciones": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/opcion"
          }
        },
        "correcta": {
          "type": "string",
          "minLength": 1
        },
        "consecuencia": {
          "type": "string",
          "minLength": 21
        },
        "explicacion": {
          "type": "string",
          "minLength": 5
        },
        "pasajeId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^DQ\\.P[12]\\.C[0-9]{2}\\.P[0-9]{4}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "imagenPrevia": {
          "$ref": "#/$defs/imagen"
        },
        "imagenConsecuencia": {
          "$ref": "#/$defs/imagen"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        }
      }
    }
  }
}
