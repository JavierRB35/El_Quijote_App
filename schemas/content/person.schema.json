{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JavierRB35/El_Quijote_App/schemas/content/person.schema.json",
  "title": "Person/Character",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "contract_version", "class", "canonical_name", "certainty", "review"],
  "properties": {
    "id": { "$ref": "_definitions.schema.json#/$defs/personId" },
    "contract_version": { "$ref": "_definitions.schema.json#/$defs/ContractVersion" },
    "class": { "type": "string", "enum": ["ficticio", "historico", "debatido"], "$comment": "Distinguir personaje ficticio, histórico real y atribución debatida (encargo §2.4, §6.2)." },
    "canonical_name": { "type": "string", "minLength": 1 },
    "variants": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["person_id", "kind"],
        "properties": {
          "person_id": { "$ref": "_definitions.schema.json#/$defs/personId" },
          "kind": { "type": "string", "minLength": 1, "$comment": "p. ej. 'escudero_de', 'amigo_de', 'posible_alusion_a'" }
        }
      }
    },
    "historical_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id"],
      "properties": {
        "source_id": { "$ref": "_definitions.schema.json#/$defs/sourceId" },
        "locator": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "appearances": { "type": "array", "items": { "$ref": "_definitions.schema.json#/$defs/episodeId" }, "uniqueItems": true },
    "certainty": { "$ref": "_definitions.schema.json#/$defs/Certainty" },
    "review": { "$ref": "_definitions.schema.json#/$defs/Review" },
    "notes": { "type": "string" }
  }
}
