{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JavierRB35/El_Quijote_App/schemas/content/edition.schema.json",
  "title": "Edition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "contract_version", "title", "editor", "year", "source_id", "digital_version", "rights_status", "orthographic_rules", "review"],
  "properties": {
    "id": { "$ref": "_definitions.schema.json#/$defs/editionId" },
    "contract_version": { "$ref": "_definitions.schema.json#/$defs/ContractVersion" },
    "title": { "type": "string", "minLength": 1 },
    "editor": { "type": "string", "minLength": 1 },
    "year": { "type": "integer", "minimum": 1605, "maximum": 2100 },
    "source_id": { "$ref": "_definitions.schema.json#/$defs/sourceId" },
    "digital_version": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "rights_status": { "$ref": "_definitions.schema.json#/$defs/LicenseStatus" },
    "orthographic_rules": { "type": "string", "enum": ["original_epoca", "modernizada"] },
    "checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "provenance": { "type": "string" },
    "notes": { "type": "string" },
    "review": { "$ref": "_definitions.schema.json#/$defs/Review" }
  }
}
