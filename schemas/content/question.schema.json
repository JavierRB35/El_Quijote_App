{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JavierRB35/El_Quijote_App/schemas/content/question.schema.json",
  "title": "Question",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "contract_version", "episode_id", "chapter_ids", "passage_ids", "prompt", "interaction", "rationale", "evidence", "certainty", "cognitive_type", "difficulty", "spoiler_policy", "visual_requirements", "language", "tags", "review", "semantic_key"],
  "properties": {
    "id": { "$ref": "_definitions.schema.json#/$defs/questionId" },
    "contract_version": { "$ref": "_definitions.schema.json#/$defs/ContractVersion" },
    "episode_id": { "$ref": "_definitions.schema.json#/$defs/episodeId" },
    "chapter_ids": { "type": "array", "items": { "$ref": "_definitions.schema.json#/$defs/chapterId" }, "minItems": 1, "uniqueItems": true },
    "passage_ids": { "type": "array", "items": { "$ref": "_definitions.schema.json#/$defs/passageId" }, "uniqueItems": true },
    "scene_id": { "$ref": "_definitions.schema.json#/$defs/sceneId" },
    "prompt": { "type": "string", "minLength": 1, "$comment": "Enunciado inequívoco en español, sin spoiler de la respuesta en el enunciado (encargo §4.3.4)." },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "options"],
      "properties": {
        "type": { "$ref": "_definitions.schema.json#/$defs/QuestionType" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "_definitions.schema.json#/$defs/optionId" },
              "label": { "type": "string", "minLength": 1 },
              "explanation": { "type": "string", "$comment": "Explicación específica de la opción si procede (encargo §6.2)." }
            }
          },
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true
        },
        "correct_option_ids": {
          "type": "array",
          "items": { "$ref": "_definitions.schema.json#/$defs/optionId" },
          "minItems": 1,
          "uniqueItems": true,
          "$comment": "Obligatoria para single_choice, multi_choice, true_false y hotspot."
        },
        "correct_order": {
          "type": "array",
          "items": { "$ref": "_definitions.schema.json#/$defs/optionId" },
          "minItems": 2,
          "uniqueItems": true,
          "$comment": "Obligatoria para ordering: secuencia canónica de TODAS las opciones."
        },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["left", "right"],
            "properties": {
              "left": { "$ref": "_definitions.schema.json#/$defs/optionId" },
              "right": { "$ref": "_definitions.schema.json#/$defs/optionId" }
            }
          },
          "minItems": 2,
          "$comment": "Obligatoria para matching."
        },
        "hotspot_area": { "$ref": "_definitions.schema.json#/$defs/NormalizedArea", "$comment": "Obligatoria para hotspot: zona correcta normalizada sobre media_id del requisito visual." },
        "multi_declared": { "type": "boolean", "$comment": "multi_choice exige true: la pregunta INDICA EXPLÍCITAMENTE que puede haber varias correctas (encargo §2.2)." },
        "shuffle_options": { "type": "boolean", "$comment": "El orden visual puede aleatorizarse; NUNCA cambia los identificadores de la respuesta correcta (encargo §4.3)." }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["single_choice", "true_false", "hotspot"] } }, "required": ["type"] },
          "then": { "required": ["correct_option_ids"] }
        },
        {
          "if": { "properties": { "type": { "const": "multi_choice" } }, "required": ["type"] },
          "then": { "required": ["correct_option_ids", "multi_declared"], "properties": { "multi_declared": { "const": true } } }
        },
        {
          "if": { "properties": { "type": { "const": "true_false" } }, "required": ["type"] },
          "then": { "properties": { "options": { "minItems": 2, "maxItems": 2 } } }
        },
        {
          "if": { "properties": { "type": { "const": "single_choice" } }, "required": ["type"] },
          "then": { "properties": { "options": { "minItems": 3 } } }
        },
        {
          "if": { "properties": { "type": { "const": "ordering" } }, "required": ["type"] },
          "then": { "required": ["correct_order"], "properties": { "shuffle_options": { "const": false }, "options": { "minItems": 3 } } }
        },
        {
          "if": { "properties": { "type": { "const": "matching" } }, "required": ["type"] },
          "then": { "required": ["pairs"], "properties": { "shuffle_options": { "const": false }, "options": { "minItems": 4 } } }
        },
        {
          "if": { "properties": { "type": { "const": "hotspot" } }, "required": ["type"] },
          "then": { "properties": { "options": { "minItems": 2 } } }
        }
      ]
    },
    "rationale": { "type": "string", "minLength": 1, "$comment": "Explicación breve verificable, siempre visible tras responder (encargo §4.3.8)." },
    "rationale_extended": { "type": "string" },
    "evidence": { "type": "array", "items": { "$ref": "_definitions.schema.json#/$defs/EvidenceItem" }, "minItems": 1 },
    "certainty": { "$ref": "_definitions.schema.json#/$defs/Certainty" },
    "cognitive_type": { "$ref": "_definitions.schema.json#/$defs/CognitiveType" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "spoiler_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_after_episodes"],
      "properties": {
        "safe_after_episodes": { "type": "array", "items": { "$ref": "_definitions.schema.json#/$defs/episodeId" }, "uniqueItems": true, "$comment": "La pregunta solo es segura tras completar estos episodios; vacío = segura desde el inicio del suyo." }
      }
    },
    "visual_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_image_must_not_reveal"],
      "properties": {
        "pre_image_media_id": { "$ref": "_definitions.schema.json#/$defs/mediaAssetId" },
        "hotspot_media_id": { "$ref": "_definitions.schema.json#/$defs/mediaAssetId" },
        "pre_image_must_not_reveal": { "type": "boolean", "enum": [true], "$comment": "La imagen previa NUNCA revela visualmente la respuesta (encargo §4.3.4, §7.2)." }
      }
    },
    "language": { "type": "string", "const": "es" },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "review": { "$ref": "_definitions.schema.json#/$defs/Review" },
    "semantic_key": { "type": "string", "minLength": 8, "$comment": "Huella semántica estable para detectar duplicados (encargo §4.3.13, §6.2); formato libre documentado." }
  }
}
